<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/fondo"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ajustes"
            android:textColor="?attr/texto"
            android:textSize="26sp"
            android:fontFamily="sans-serif-light"
            android:paddingBottom="20dp" />

        <TextView
            style="@style/Etiqueta"
            android:text="Tema de color" />

        <LinearLayout
            android:id="@+id/temasBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp" />

        <TextView
            style="@style/Etiqueta"
            android:text="Sonido y movimiento" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swFx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Efectos de sonido al tocar"
            android:textColor="?attr/texto"
            android:textSize="14sp"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="10dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swAnim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Animaciones"
            android:textColor="?attr/texto"
            android:textSize="14sp"
            android:background="@drawable/bg_card"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Los efectos usan los tonos del sistema, así que no gastan espacio ni batería."
            android:textColor="?attr/tenue"
            android:textSize="11.5sp"
            android:lineSpacingExtra="3dp"
            android:paddingTop="14dp" />

        <TextView
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver"
            android:gravity="center"
            android:textColor="?attr/acento"
            android:textSize="14sp"
            android:padding="18dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</ScrollView>
