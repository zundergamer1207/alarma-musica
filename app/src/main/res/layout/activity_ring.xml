<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/anillo"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/bell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/ringTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="07:00"
            android:textColor="?attr/texto"
            android:textSize="58sp"
            android:fontFamily="sans-serif-light"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/ringLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alarma"
            android:textColor="?attr/acento"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/ringSound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/tenue"
            android:textSize="12.5sp"
            android:paddingTop="4dp"
            android:paddingBottom="18dp" />

        <!-- Bloque de la ruleta: solo visible si la alarma la tiene activada -->
        <LinearLayout
            android:id="@+id/ruletaBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <com.oscarpolonio.alarma.RouletteView
                android:id="@+id/ruleta"
                android:layout_width="250dp"
                android:layout_height="250dp" />

            <TextView
                android:id="@+id/ruletaMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/tenue"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

            <Button
                android:id="@+id/btnSpin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GIRAR"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#1A1208"
                android:padding="16dp"
                android:background="@drawable/btn_primary" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apagar"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#161111"
            android:padding="16dp"
            android:background="@drawable/btn_white" />

        <Button
            android:id="@+id/btnSnooze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Posponer 5 min"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="?attr/texto"
            android:padding="14dp"
            android:background="@drawable/bg_card"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
