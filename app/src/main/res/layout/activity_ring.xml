<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/ringbg"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔔"
        android:textSize="58sp" />

    <TextView
        android:id="@+id/ringTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="07:00"
        android:textColor="@color/txt"
        android:textSize="68sp"
        android:fontFamily="sans-serif-light"
        android:paddingTop="12dp" />

    <TextView
        android:id="@+id/ringLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alarma"
        android:textColor="@color/accent"
        android:textSize="19sp"
        android:textStyle="bold"
        android:paddingTop="4dp" />

    <TextView
        android:id="@+id/ringSound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/dim"
        android:textSize="12.5sp"
        android:paddingTop="6dp"
        android:paddingBottom="40dp" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apagar"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#161111"
        android:padding="16dp"
        android:background="@drawable/btn_white" />

    <Button
        android:id="@+id/btnSnooze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Posponer 5 min"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textColor="@color/txt"
        android:padding="14dp"
        android:background="@drawable/bg_card"
        android:layout_marginTop="12dp" />
</LinearLayout>
